# MODELO. Copie para secrets.properties e preencha. O secrets.properties NÃO vai para o Git.
# Carregado automaticamente por application.yml (spring.config.import).
# Em produção, estes valores vêm de variáveis de ambiente (ver backend/.env.example).

# --- Base de dados MySQL ---
spring.datasource.url=jdbc:mysql://localhost:3306/encomendas?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Maputo
spring.datasource.username=SEU_UTILIZADOR
spring.datasource.password=SUA_PALAVRA_PASSE

# --- Segurança ---
app.jwt-secret=GERE_UMA_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES

# --- Administrador inicial (criado no 1.º arranque se não existir nenhum) ---
app.admin.email=SEU_EMAIL_ADMIN
app.admin.password=PALAVRA_PASSE_FORTE_8_OU_MAIS

# --- Fotos (Cloudinary). Para usar: app.storage=cloudinary ---
# app.storage=cloudinary
# cloudinary.url=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Email (SMTP) ---
# spring.mail.host=smtp.exemplo.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
